# Existing Basic-auth values; the server and public pairs must match.
NUXT_USERNAME=site-api-user
NUXT_USERPASS=site-api-password
NUXT_PUBLIC_USERNAME=site-api-user
NUXT_PUBLIC_USERPASS=site-api-password

# Server-only secret, at least 32 characters. Generate with openssl rand -hex 32.
NUXT_CMS_SESSION_PASSWORD=

# Required for password emails.
NUXT_MAILGUN_API_KEY=
NUXT_EMAIL_FROM=CMS <cms@example.com>
# Optional overrides; these values are the site's defaults.
NUXT_CMS_MAILGUN_DOMAIN=mg.framecore.se
NUXT_CMS_MAILGUN_BASE_URL=https://api.eu.mailgun.net
